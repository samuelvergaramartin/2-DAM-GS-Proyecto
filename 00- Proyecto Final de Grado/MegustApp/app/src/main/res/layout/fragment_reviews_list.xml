<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fragment_reviews_list"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorPrimary">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/valoraciones"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="@color/accentAlt"
        android:textAlignment="center"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:id="@+id/texto_sin_valoraciones_fragment_reviews_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sin_valoraciones"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="@color/accent"
        android:textAlignment="center"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/valoraciones_fragment_reviews_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

<!--    <ListView-->
<!--        android:id="@+id/valoraciones_fragment_reviews_list"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="match_parent" />-->
</LinearLayout>